{
  "name": "airstack",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "run_worker_first": ["/e"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "airstack-o11y", "database_id": "737f7b40-b166-46c2-848f-8328a2898336" }
  ],
  "vars": {
    "LIMITS": {
      "keyHex": 16,
      "perDay": 600,
      "perMinute": 60,
      "rejectFlush": 50,
      "idsTtl": 3600,
      "sizes": [1, 2, 3, 5, 10, 20],
      "steps": { "lcp": 100, "inp": 10, "cls": 10 },
      "caps": { "lcp": 10000, "inp": 2000, "cls": 1000 }
    }
  },
  "routes": [
    { "pattern": "airstack.bot", "custom_domain": true }
  ]
}
